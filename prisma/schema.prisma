// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`



generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"

}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String
  bio       String?
  gender    String?
  birthDate DateTime?
  photos    String[]
  
  latitude  Float?
  longitude Float?

  isVerified Boolean @default(false)
  isPremium  Boolean @default(false)
  prompts    Json?
  jobTitle   String?
  company    String?
  school     String?
  languages  String[]
  zodiac     String?
  familyPlans String?
  covidVaccine String?
  personalityType String?
  communicationStyle String?
  loveStyle  String?
  pets       String?
  drinking   String?

  instagram  String?
  snapchat   String?
  twitter    String?
  showSocials Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginProvider LoginProvider

  swipesGiven    Swipe[]   @relation("SwipesGiven")
  swipesReceived Swipe[]   @relation("SwipesReceived")
  matches1       Match[]   @relation("MatchUser1")
  matches2       Match[]   @relation("MatchUser2")
  messages       Message[]
  tags           Tag[] @relation("UserTags")
  analytics      Analytics?
  posts          Post[]
  revealedReceipts RevealedReceipt[]

  tokens         Int @default(0)
  superlikeTokens Int @default(0)
  dmTokens       Int @default(0)
  rewindTokens   Int @default(0)

  lastRewardClaimDate DateTime?
  rewardDayCounter    Int @default(0)

  country          String?   @default("United States")
  preferredCountry String?   @default("All")
  isPaused         Boolean   @default(false)
  premiumUntil     DateTime?
  subscriptionPlan String?
  platformReceipt  String?
  iapPlatform      String?

  blockedUsers     BlockedUser[] @relation("BlockingUser")
  blockedBy        BlockedUser[] @relation("BlockedUser")
  reportsSent      UserReport[]  @relation("ReporterUser")
  reportsReceived  UserReport[]  @relation("ReportedUser")
  suggestions      FeatureSuggestion[]
  purchases        PurchaseTransaction[] @relation("UserPurchases")
}

model Analytics {
  id          String   @id @default(uuid())
  userId      String   @unique
  profileViews Int      @default(0)
  likes        Int      @default(0)
  superLikes   Int      @default(0)
  dislikes     Int      @default(0)
  matches      Int      @default(0)
  unmatches    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Tag{
  id String @id @default(uuid())
  name String @unique
  category String?
  users User[] @relation("UserTags")
}

enum LoginProvider {
  EMAIL
  GOOGLE
}

enum SwipeType {
  LIKE
  DISLIKE
  SUPERLIKE
}

model Swipe {
  id         String    @id @default(uuid())
  swiperId   String
  swipedId   String
  type       SwipeType
  createdAt  DateTime  @default(now())

  swiper     User      @relation("SwipesGiven", fields: [swiperId], references: [id], onDelete: Cascade)
  swiped     User      @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)

  @@unique([swiperId, swipedId])
}

model Match {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unmatchedAt DateTime?
  isUnmatched Boolean @default(false)

  isDirectDM  Boolean  @default(false)
  dmStatus    String?  // "PENDING", "ACCEPTED", "REJECTED"
  dmSenderId  String?

  user1     User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@unique([user1Id, user2Id])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  content   String
  imageUrl  String?
  gifUrl    String?
  replyToId String?
  replyToContent String?
  replyToSenderName String?
  replyToType String?
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
  isRevealed Boolean @default(false)

  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  revealedReceipts RevealedReceipt[]

  @@index([matchId, createdAt])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model RevealedReceipt {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?  @default("Inappropriate behavior")
  createdAt DateTime @default(now())

  blocker   User     @relation("BlockingUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserReport {
  id          String   @id @default(uuid())
  reporterId  String
  reportedId  String
  reason      String
  description String?
  createdAt   DateTime @default(now())

  reporter    User     @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reported    User     @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)
}

model FeatureSuggestion {
  id          String   @id @default(uuid())
  userId      String?
  title       String
  description String
  category    String?  @default("Feature")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PurchaseTransaction {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserPurchases", fields: [userId], references: [id], onDelete: Cascade)
  productId       String
  plan            String
  platform        String   // "GOOGLE_PLAY" or "APP_STORE"
  receipt         String
  amount          Float?
  currency        String?  @default("USD")
  status          String   @default("VERIFIED")
  createdAt       DateTime @default(now())
}
